{
    "name": "@nnts/result",
    "version": "0.0.1-beta",
    "description": "A lightweight Result type inspired by Rust.",
    "keywords": [
        "rust",
        "typescript"
    ],
    "homepage": "https://github.com/namvnn/nnts#readme",
    "bugs": "https://github.com/namvnn/nnts/issues",
    "license": "MIT",
    "author": "Nam Nguyen <nam@namn.me>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/namvnn/nnts.git",
        "directory": "packages/result"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": "./src/index.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "import": "./dist/index.mjs",
                "require": "./dist/index.cjs"
            },
            "./package.json": "./package.json"
        }
    },
    "engines": {
        "node": "*"
    }
}
