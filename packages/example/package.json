{
    "name": "@nnts/example",
    "version": "0.0.1-beta",
    "description": "An example of nnts package.",
    "homepage": "https://github.com/namvnn/nnts",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/namvnn/nnts.git",
        "directory": "packages/example"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": "./src/index.ts",
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "import": "./dist/index.mjs",
                "require": "./dist/index.cjs"
            },
            "./package.json": "./package.json"
        }
    },
    "scripts": {
        "build": "tsdown --minify",
        "dev": "tsdown --watch"
    },
    "engines": {
        "node": "*"
    }
}
