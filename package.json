{
    "name": "@nnts/monorepo",
    "version": "0.0.1-beta",
    "private": true,
    "description": "TypeScript libraries and developer tools.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/namvnn/nnts.git"
    },
    "type": "module",
    "scripts": {
        "build": "tsdown --minify",
        "build:pkg": "tsdown --minify --filter",
        "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test --run",
        "dev": "tsdown --watch",
        "dev:pkg": "tsdown --watch --filter",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "prepare": "husky",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "typecheck": "tsc --build",
        "typecheck:clean": "tsc --build --clean",
        "typecheck:debug": "tsc --build --diagnostics",
        "typecheck:watch": "tsc --build --watch"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "0.18.5",
        "@types/node": "26.1.2",
        "@vitest/coverage-v8": "4.1.10",
        "@vitest/ui": "4.1.10",
        "husky": "9.1.7",
        "lint-staged": "17.3.0",
        "oxfmt": "0.62.0",
        "oxlint": "1.77.0",
        "oxlint-tsgolint": "7.0.2001",
        "publint": "0.3.23",
        "tsdown": "0.22.14",
        "typescript": "7.0.2",
        "vitest": "4.1.10"
    },
    "packageManager": "pnpm@11.20.0"
}
