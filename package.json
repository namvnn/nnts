{
    "name": "@nnts/monorepo",
    "version": "0.0.1-beta",
    "private": true,
    "description": "TypeScript libraries and developer tools.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/namvnn/nnts.git"
    },
    "type": "module",
    "scripts": {
        "build": "tsdown --minify",
        "build:pkg": "tsdown --minify --filter",
        "dev": "tsdown --watch",
        "dev:pkg": "tsdown --watch --filter",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "prepare": "husky",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "typecheck": "tsc --build",
        "typecheck:clean": "tsc --build --clean",
        "typecheck:watch": "tsc --build --watch"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "0.18.4",
        "@types/node": "26.1.0",
        "@vitest/coverage-v8": "4.1.9",
        "@vitest/ui": "4.1.9",
        "husky": "9.1.7",
        "lint-staged": "17.0.8",
        "oxfmt": "0.57.0",
        "oxlint": "1.72.0",
        "oxlint-tsgolint": "0.24.0",
        "publint": "0.3.21",
        "tsdown": "0.22.3",
        "typescript": "6.0.3",
        "vitest": "4.1.9"
    },
    "packageManager": "pnpm@11.20.0"
}
